{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".medota2/typecheck/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "playwright.config.ts",
    "playwright.shared.config.ts",
    "drizzle.config.ts",
    "next.config.ts"
  ],
  "exclude": ["node_modules", ".next*", ".medota2"]
}
