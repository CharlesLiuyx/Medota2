{
  "name": "medota2",
  "version": "0.1.0",
  "private": true,
  "description": "A provenance-first local Dota 2 metadata explorer.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:demo": "docker compose up -d postgres && pnpm data:import:vpk:preview && DATABASE_URL_WEB=postgresql://medota2_web:medota2_web@127.0.0.1:54321/medota2_test next dev",
    "test": "vitest run --exclude tests/integration/** --exclude tests/e2e/**",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:prepare": "tsx tests/helpers/seed-test-database.ts --include-failure",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/workers/migrate.ts",
    "db:migrate:test": "tsx src/workers/migrate-test.ts",
    "db:studio": "drizzle-kit studio",
    "data:import:vpk": "tsx src/workers/import-vpk.ts",
    "data:import:vpk:preview": "tsx src/workers/import-vpk.ts --local-preview",
    "data:import:dotaconstants": "tsx src/workers/import-dotaconstants.ts",
    "data:compare:heroes": "tsx src/workers/compare-heroes.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "pg": "8.23.0",
    "pg-copy-streams": "7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/pg-copy-streams": "1.2.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
