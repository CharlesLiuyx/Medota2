{
  "name": "medota2",
  "version": "0.1.0",
  "private": true,
  "description": "A provenance-first local Dota 2 metadata explorer.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=web MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox NEXT_DIST_DIR=.next next dev -H 127.0.0.1 -p 3000",
    "dev:local": "pnpm db:local-review:start && MEDOTA2_STATE_DIRECTORY=.medota2/environments/local-review MEDOTA2_PROCESS_ROLE=web MEDOTA2_ENVIRONMENT=local-review MEDOTA2_DATA_CLASS=production-snapshot NEXT_DIST_DIR=.next-local next dev --webpack -H 127.0.0.1 -p 3001",
    "dev:test": "pnpm test:e2e",
    "build": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=web MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox NEXT_DIST_DIR=.next next build --webpack",
    "start": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=web MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox NEXT_DIST_DIR=.next next start -H 127.0.0.1 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:demo": "pnpm dev:local",
    "test": "MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox vitest run",
    "test:watch": "MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox vitest",
    "test:coverage": "MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox vitest run --coverage",
    "test:integration": "tsx src/workers/run-test-suite.ts integration",
    "test:e2e": "tsx src/workers/run-test-suite.ts e2e",
    "test:e2e:concurrent": "tsx src/workers/run-concurrent-e2e.ts",
    "test:harness:isolation": "tsx src/workers/run-failure-isolation.ts",
    "verify": "tsx src/workers/run-test-suite.ts verify",
    "db:generate": "MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox drizzle-kit generate",
    "db:local:bootstrap": "pnpm db:development:provision",
    "db:local:start": "pnpm db:development:start",
    "db:development:provision": "tsx src/workers/manage-data-stack.ts --action provision --environment development --confirm provision:development",
    "db:development:start": "tsx src/workers/manage-data-stack.ts --action start --environment development",
    "db:development:stop": "tsx src/workers/manage-data-stack.ts --action stop --environment development",
    "db:local-review:provision": "tsx src/workers/manage-data-stack.ts --action provision --environment local-review --confirm provision:local-review",
    "db:local-review:start": "tsx src/workers/manage-data-stack.ts --action start --environment local-review",
    "db:local-review:stop": "tsx src/workers/manage-data-stack.ts --action stop --environment local-review",
    "db:migrate": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=migration MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/migrate.ts",
    "db:migrate:local": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/local-review MEDOTA2_PROCESS_ROLE=migration MEDOTA2_ENVIRONMENT=local-review MEDOTA2_DATA_CLASS=production-snapshot MEDOTA2_DATABASE_CONFIRMATION=medota2_local tsx src/workers/migrate.ts",
    "db:environment:adopt:local-stack": "MEDOTA2_PROCESS_ROLE=control tsx src/workers/adopt-local-environments.ts",
    "db:environment:doctor": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=control MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/environment-doctor.ts",
    "db:environment:doctor:local": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/local-review MEDOTA2_PROCESS_ROLE=control MEDOTA2_ENVIRONMENT=local-review MEDOTA2_DATA_CLASS=production-snapshot MEDOTA2_DATABASE_CONFIRMATION=medota2_local tsx src/workers/environment-doctor.ts",
    "db:environment:doctor:legacy": "MEDOTA2_PROCESS_ROLE=control MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/environment-doctor.ts",
    "data:import:catalog": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=worker MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/import-catalog.ts",
    "data:import:catalog:preview": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/local-review MEDOTA2_PROCESS_ROLE=control MEDOTA2_ENVIRONMENT=local-review MEDOTA2_DATA_CLASS=production-snapshot MEDOTA2_DATABASE_CONFIRMATION=medota2_local tsx src/workers/import-catalog.ts --local-preview",
    "data:import:vpk": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=worker MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/import-catalog.ts",
    "data:import:vpk:preview": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/local-review MEDOTA2_PROCESS_ROLE=control MEDOTA2_ENVIRONMENT=local-review MEDOTA2_DATA_CLASS=production-snapshot MEDOTA2_DATABASE_CONFIRMATION=medota2_local tsx src/workers/import-catalog.ts --local-preview",
    "data:import:vpk:local": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/local-review MEDOTA2_PROCESS_ROLE=control MEDOTA2_ENVIRONMENT=local-review MEDOTA2_DATA_CLASS=production-snapshot MEDOTA2_DATABASE_CONFIRMATION=medota2_local tsx src/workers/import-catalog.ts --local-preview --download-missing",
    "data:reset:local-review": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/local-review MEDOTA2_PROCESS_ROLE=migration MEDOTA2_ENVIRONMENT=local-review MEDOTA2_DATA_CLASS=production-snapshot tsx src/workers/reset-local-review.ts",
    "data:import:dotaconstants": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=worker MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/import-dotaconstants.ts",
    "data:compare:heroes": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=worker MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/compare-heroes.ts",
    "data:audit:catalog": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=web MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/audit-catalog.ts",
    "data:diff:catalog": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=web MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/diff-catalog.ts",
    "data:review:catalog": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=worker MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/review-catalog.ts",
    "data:promote:catalog": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=worker MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/promote-catalog.ts",
    "data:rollback:catalog": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=worker MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/rollback-catalog.ts",
    "data:source:discover:vpk": "tsx src/workers/discover-vpk-source.ts",
    "data:source:lock:vpk": "tsx src/workers/lock-vpk-source.ts",
    "data:extract:assets:vpk": "tsx src/workers/extract-vpk-assets.ts",
    "data:import:assets": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=worker MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/import-assets.ts",
    "data:audit:assets": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=web MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/audit-assets.ts",
    "data:refresh:catalog:development": "MEDOTA2_STATE_DIRECTORY=.medota2/environments/development MEDOTA2_PROCESS_ROLE=control MEDOTA2_ENVIRONMENT=development MEDOTA2_DATA_CLASS=sandbox tsx src/workers/refresh-catalog.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "pg": "8.23.0",
    "pg-copy-streams": "7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
