# PostgreSQL 18 local defaults from docker-compose.yml.
DATABASE_URL_MIGRATION=postgresql://medota2_owner:medota2_owner@127.0.0.1:54321/medota2
DATABASE_URL_WORKER=postgresql://medota2_worker:medota2_worker@127.0.0.1:54321/medota2
DATABASE_URL_WEB=postgresql://medota2_web:medota2_web@127.0.0.1:54321/medota2
DATABASE_URL_MIGRATION_TEST=postgresql://medota2_owner:medota2_owner@127.0.0.1:54321/medota2_test
DATABASE_URL_WORKER_TEST=postgresql://medota2_worker:medota2_worker@127.0.0.1:54321/medota2_test
DATABASE_URL_WEB_TEST=postgresql://medota2_web:medota2_web@127.0.0.1:54321/medota2_test
DATABASE_URL_MIGRATION_LOCAL=postgresql://medota2_owner:medota2_owner@127.0.0.1:54321/medota2_local
DATABASE_URL_WORKER_LOCAL=postgresql://medota2_worker:medota2_worker@127.0.0.1:54321/medota2_local
DATABASE_URL_WEB_LOCAL=postgresql://medota2_web:medota2_web@127.0.0.1:54321/medota2_local

# External repositories are configurable and remain read-only.
DOTA_VPK_UPDATES_PATH=../dota_vpk_updates
DOTACONSTANTS_PATH=../dotaconstants
DOTA_VPK_REMOTE_URL=https://github.com/spirit-bear-productions/dota_vpk_updates.git
DOTA_VPK_MIRROR_PATH=.medota2/cache/dota-vpk.git
DOTA_VPK_WORKTREE_ROOT=.medota2/cache/worktrees
DOTA_VPK_LOCK_ROOT=.medota2/locks

# Required inputs for pnpm data:extract:assets:vpk.
DOTA_VPK_PATH=
SOURCE2VIEWER_CLI_PATH=
DOTA_VALVE_ASSET_CLIENT_VERSION=

# New, versioned final directory produced atomically by the extractor.
# It must not already exist and must remain outside the VPK directory.
# Expected roots include panorama/images/heroes and panorama/images/spellicons.
DOTA_VALVE_ASSET_PATH=

# Optional HTTPS webhook for refresh state changes.
CATALOG_NOTIFICATION_WEBHOOK_URL=
