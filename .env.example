# Non-secret development defaults. Official package scripts pin the matching
# state root under .medota2/environments/<environment>.
MEDOTA2_ENVIRONMENT=development
MEDOTA2_DATA_CLASS=sandbox
MEDOTA2_RUN_ID=
# Official scripts set this admission label to web, worker, migration, or
# control. Do not put a permanent control label in .env.
MEDOTA2_PROCESS_ROLE=
# Non-production commands resolve these from the 0600 provisioning receipt and
# reject conflicting overrides. Production requires all three values explicitly.
MEDOTA2_EXPECTED_INSTANCE_ID=
MEDOTA2_EXPECTED_DATABASE_ID=
MEDOTA2_EXPECTED_POSTGRES_SYSTEM_IDENTIFIER=
MEDOTA2_DATABASE_CONFIRMATION=

# Non-production URLs are generated into environment-specific private 0600
# receipts by pnpm db:development:provision or
# pnpm db:local-review:provision. They never belong in .env. The managed
# lifecycle creates and rotates its own bootstrap secret.
#
# MEDOTA2_STATE_DIRECTORY and MEDOTA2_NETWORK_POLICY are orchestration inputs.
# Official scripts set them; do not persist Test Run state/port/artifact values
# here. The low-level legacy cutover can accept a shell/keychain bootstrap URL
# only during separately authorized recovery and rejects it from .env.

# Production is intentionally unset. It additionally requires verify-full TLS
# plus both identity UUIDs and the PostgreSQL system identifier from its receipt
# (all three expected-identity values must be configured together).
DATABASE_URL_MIGRATION_PRODUCTION=
DATABASE_URL_WORKER_PRODUCTION=
DATABASE_URL_WEB_PRODUCTION=

# External repositories are configurable and remain read-only.
DOTA_VPK_UPDATES_PATH=../dota_vpk_updates
DOTACONSTANTS_PATH=../dotaconstants
DOTA_VPK_REMOTE_URL=https://github.com/spirit-bear-productions/dota_vpk_updates.git
DOTA_VPK_MIRROR_PATH=.medota2/cache/dota-vpk.git
DOTA_VPK_WORKTREE_ROOT=.medota2/cache/worktrees
DOTA_VPK_LOCK_ROOT=.medota2/locks

# Required inputs for pnpm data:extract:assets:vpk.
DOTA_VPK_PATH=
SOURCE2VIEWER_CLI_PATH=
DOTA_VALVE_ASSET_CLIENT_VERSION=

# New, versioned final directory produced atomically by the extractor.
# It must not already exist and must remain outside the VPK directory.
# Expected roots include panorama/images/heroes and panorama/images/spellicons.
DOTA_VALVE_ASSET_PATH=

# Optional HTTPS webhook for refresh state changes.
CATALOG_NOTIFICATION_WEBHOOK_URL=
